generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  LECTURER
  REVIEWER
  ADMIN
}

enum SessionStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ScriptStatus {
  PENDING
  DIGITIZED
  SCORED
  REVIEWED
  FLAGGED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LECTURER)
  createdAt    DateTime @default(now())

  markingGuides    MarkingGuide[]
  markingSessions  MarkingSession[]
  verificationCodes VerificationCode[]
}

// Reusable "send a code, verify it" mechanism — used for password reset now,
// and for OTP login later, distinguished by purpose.
model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String   // "PASSWORD_RESET" | "LOGIN_OTP"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MarkingGuide {
  id          String   @id @default(cuid())
  title       String
  subject     String?
  isDraft     Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  sessions  MarkingSession[]
}

model Question {
  id          String       @id @default(cuid())
  guideId     String
  guide       MarkingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  number      String       @default("1")
  subLabel    String?
  text        String
  modelAnswer String
  keywords    String
  maxMarks    Int
  order       Int          @default(0)

  scriptAnswers ScriptAnswer[]
}

model MarkingSession {
  id          String        @id @default(cuid())
  title       String
  department  String?
  faculty     String?
  guideId     String?
  guide       MarkingGuide? @relation(fields: [guideId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      SessionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  scripts Script[]
}

model Script {
  id                    String       @id @default(cuid())
  sessionId             String
  session               MarkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentIdentifier     String?
  studentName           String?
  regNumber             String?
  caScore               Float?
  imageUrl              String?
  ocrText               String?
  ocrConfidence         Float?
  status                ScriptStatus @default(PENDING)
  totalScore            Float?
  hasLowConfidenceScore Boolean      @default(false)
  uploadedAt            DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  pages   ScriptPage[]
  answers ScriptAnswer[]
}

model ScriptPage {
  id            String   @id @default(cuid())
  scriptId      String
  script        Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  pageNumber    Int
  imageUrl      String
  ocrText       String?
  ocrConfidence Float?
  createdAt     DateTime @default(now())
}

model ScriptAnswer {
  id             String    @id @default(cuid())
  scriptId       String
  script         Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id])
  extractedText  String?
  suggestedScore Float?
  confidence     String?
  confirmedScore Float?
  reasoning      String?
  confirmedAt    DateTime?
}
