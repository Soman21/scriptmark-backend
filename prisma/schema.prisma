// ScriptMark database schema
// Run `npx prisma migrate dev` after setting DATABASE_URL to generate tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LECTURER
  REVIEWER
  ADMIN
}

enum SessionStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ScriptStatus {
  PENDING
  DIGITIZED
  REVIEWED
  FLAGGED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LECTURER)
  createdAt    DateTime @default(now())

  markingGuides  MarkingGuide[]
  markingSessions MarkingSession[]
}

model MarkingGuide {
  id          String   @id @default(cuid())
  title       String
  subject     String?
  isDraft     Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  sessions  MarkingSession[]
}

model Question {
  id           String  @id @default(cuid())
  guideId      String
  guide        MarkingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  number       String   @default("1") // e.g. "1", "2" — groups sub-parts together
  subLabel     String?  // e.g. "a", "b", "c" — null means this question has no sub-parts
  text         String
  modelAnswer  String
  keywords     String   // comma-separated
  maxMarks     Int
  order        Int      @default(0)

  scriptAnswers ScriptAnswer[]
}

model MarkingSession {
  id          String        @id @default(cuid())
  title       String        // used as the course title on exported reports
  department  String?
  faculty     String?
  guideId     String?
  guide       MarkingGuide? @relation(fields: [guideId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      SessionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  scripts Script[]
}

model Script {
  id                String       @id @default(cuid())
  sessionId         String
  session           MarkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentIdentifier String?      // free-text fallback (kept for backward compatibility)
  studentName       String?
  regNumber         String?
  caScore           Float?       // Continuous Assessment score, entered manually by the lecturer
  imageUrl          String?      // first/primary page image, kept for quick preview
  ocrText           String?      // combined OCR text across ALL pages of this script
  ocrConfidence     Float?       // average confidence across pages
  status            ScriptStatus @default(PENDING)
  totalScore        Float?
  uploadedAt        DateTime     @default(now())

  pages   ScriptPage[]
  answers ScriptAnswer[]
}

// A single physical page of a (possibly multi-page) exam script. A real exam script
// can be 12+ pages; each page is uploaded and OCR'd separately, then combined onto
// the parent Script's ocrText for scoring.
model ScriptPage {
  id            String   @id @default(cuid())
  scriptId      String
  script        Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  pageNumber    Int
  imageUrl      String
  ocrText       String?
  ocrConfidence Float?
  createdAt     DateTime @default(now())
}

model ScriptAnswer {
  id              String   @id @default(cuid())
  scriptId        String
  script          Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id])
  extractedText   String?
  suggestedScore  Float?
  confirmedScore  Float?
  reasoning       String?
  confirmedAt     DateTime?
}
