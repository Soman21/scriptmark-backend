generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  LECTURER
  REVIEWER
  ADMIN
}

enum SessionStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ScriptStatus {
  PENDING
  DIGITIZED
  SCORED
  REVIEWED
  FLAGGED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(LECTURER)
  createdAt    DateTime @default(now())

  // Lecturer profile. lecturerId is given by ScriptMark (NAU0042), never
  // typed. A suspended account keeps all its work but cannot sign in.
  lecturerId    String?      @unique
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  suspendedAt   DateTime?
  suspendReason String?
  lastActiveAt  DateTime?

  markingGuides     MarkingGuide[]
  markingSessions   MarkingSession[]
  verificationCodes VerificationCode[]
  markerOfSessions  SessionMarker[]
  assignedQuestions Question[]         @relation("AssignedQuestions")
  changedAnswers    ScriptAnswer[]     @relation("ChangedAnswers")
  notifications     Notification[]
  adminGrant        AdminGrant?
}

// An account the owner made an Admin from the Admin page. Kept apart from
// User.role on purpose: a stored role of ADMIN is never trusted on its own
// (see lib/roles.js), only this table and the Admin email list are.
model AdminGrant {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedById String
  createdAt   DateTime @default(now())
}

// What happened in the app, newest first, for the Admin page. Names are
// copied in, not linked, so the history stays readable after an account or
// session is deleted.
// type: SIGNUP | SESSION_CREATED | GUIDE_CREATED | LECTURER_JOINED |
//   SCRIPTS_UPLOADED | RESULTS_EXPORTED | ADMIN_ADDED | ADMIN_REMOVED
model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  actorId   String?
  actorName String?
  sessionId String?
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One line in a user's notification bell. Events that happened (a join
// request, an approval) are stored here; reminders that depend on the
// current state (no questions claimed yet) are worked out on each request
// instead, so they disappear on their own once the work is done.
// type: JOIN_REQUEST | REQUEST_APPROVED | REQUEST_DECLINED | JOINED | SESSION_CONFIRMED
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  sessionId String?
  // Who caused it, e.g. the lecturer asking to join. Kept as a plain id so
  // deleting that account does not delete other people's notifications.
  actorId   String?
  text      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// A lecturer attached to a session as one of its markers, separate from
// whoever created the session (the Coordinator, via createdById below).
// A user can be both the Coordinator and a marker on the same session.
model SessionMarker {
  id        String         @id @default(cuid())
  sessionId String
  session   MarkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  // PENDING until the Coordinator (or a Full-access marker) approves a
  // request; joining with the code skips straight to APPROVED.
  status       String   @default("APPROVED")
  // LIMITED (default): can only claim/edit their own questions. FULL: can
  // see and act across the whole session, same as the Coordinator.
  accessLevel  String   @default("LIMITED")
  createdAt DateTime       @default(now())

  @@unique([sessionId, userId])
}

// Reusable "send a code, verify it" mechanism — used for password reset now,
// and for OTP login later, distinguished by purpose.
model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   String   // "PASSWORD_RESET" | "LOGIN_OTP"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MarkingGuide {
  id          String   @id @default(cuid())
  title       String
  subject     String?
  isDraft     Boolean  @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // The actual uploaded question paper file, kept so markers can preview it
  // in its original layout later, not just the AI-extracted text.
  questionPaperUrl      String?
  questionPaperMimeType String?

  questions Question[]
  sessions  MarkingSession[]
}

model Question {
  id          String       @id @default(cuid())
  guideId     String
  guide       MarkingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  number      String       @default("1")
  subLabel    String?
  text        String
  modelAnswer String
  keywords    String
  maxMarks    Int
  order       Int          @default(0)

  assignedMarkerId String?
  assignedMarker   User?   @relation("AssignedQuestions", fields: [assignedMarkerId], references: [id])

  // Flagged during guide parsing (or manually by the lecturer) when a question
  // involves calculation/working that standard OCR is likely to mangle. Such
  // questions get an extra vision model re transcription pass before scoring,
  // see groq.js transcribeCalculationFromImage.
  isCalculationHeavy Boolean @default(false)

  // Optional step by step marking rubric: an array of { description, marks }
  // objects whose marks should sum to maxMarks. When present, the AI scores
  // and awards marks per step instead of one flat holistic score.
  steps Json?

  scriptAnswers ScriptAnswer[]
}

model MarkingSession {
  id          String        @id @default(cuid())
  title       String
  department  String?
  joinCode    String?       @unique
  faculty     String?
  courseCode       String?
  examinationType  String?
  academicSession  String?
  semester         String?
  // Share of the course total this assessment carries, e.g. 70 for the
  // exam and 20 for a test. Null means use the default (see courses.js).
  weight           Float?
  // Coordinator is NOT a separate role — whoever created the session (below)
  // administers it. autoAcceptHighConfidence controls whether high-confidence
  // AI scores skip human review entirely for this session, per that decision.
  autoAcceptHighConfidence Boolean @default(true)
  guideId     String?
  guide       MarkingGuide? @relation(fields: [guideId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  status      SessionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  // Roster used to correct OCR-guessed student name/reg number at marking
  // time. A single merged list, built from whichever documents get uploaded
  // (attendance sheet at script-upload time, official class list nearer
  // export, either order, either both or just one) — see roster.js. Each
  // entry: { id, name, regNumber, flagged, conflict: null | { name, regNumber, uploadId } }.
  // No relation table on purpose: entries are only ever read/written as a
  // whole list against a session, never queried individually.
  classList        Json?
  // One entry per upload that has ever contributed to classList, so a
  // flagged entry's conflict can point back to the actual source document
  // for the lecturer to preview. { id, documentUrl, mimeType, previewText, uploadedAt }.
  classListUploads Json?

  scripts Script[]
  markers SessionMarker[]
}

model Script {
  id                    String       @id @default(cuid())
  sessionId             String
  session               MarkingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentIdentifier     String?
  studentName           String?
  regNumber             String?
  // Soft reference (not a Prisma relation, since classList lives as JSON on
  // the session) to the classList entry this script was matched to by reg
  // number, if any. Used to look the entry back up when checking whether a
  // script's identity is still resting on an unresolved flagged conflict,
  // e.g. before allowing export. Null means no roster was uploaded yet, or
  // nothing in it matched this script's OCR-detected reg number.
  classListEntryId     String?
  caScore               Float?
  imageUrl              String?
  ocrText               String?
  ocrConfidence         Float?
  status                ScriptStatus @default(PENDING)
  totalScore            Float?
  hasLowConfidenceScore Boolean      @default(false)
  uploadedAt            DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  pages   ScriptPage[]
  answers ScriptAnswer[]
}

model ScriptPage {
  id            String   @id @default(cuid())
  scriptId      String
  script        Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  pageNumber    Int
  imageUrl      String
  ocrText       String?
  ocrConfidence Float?
  createdAt     DateTime @default(now())
}

model ScriptAnswer {
  id             String    @id @default(cuid())
  scriptId       String
  script         Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id])
  extractedText  String?
  suggestedScore Float?
  confidence     String?
  confirmedScore Float?
  reasoning      String?
  confirmedAt    DateTime?

  // True when confirmedScore was set automatically by the high-confidence
  // auto-accept rule, rather than by a human clicking confirm.
  autoAccepted Boolean @default(false)

  // Audit trail: populated only when an ALREADY-confirmed score is changed
  // again afterward (e.g. a Coordinator overriding a lecturer's confirmed
  // score). The first confirmation is never treated as an "override".
  previousScore  Float?
  changeReason   String?
  changedById    String?
  changedBy      User?     @relation("ChangedAnswers", fields: [changedById], references: [id])
  changedAt      DateTime?

  // Populated only for isCalculationHeavy questions: the vision model's
  // re transcription of the page image(s), used in place of the standard
  // OCR text for that question's scoring pass. Shown to the reviewer so
  // they can check what the AI actually read, not just trust the score.
  visionTranscript String?

  // What the answer really says, typed or corrected by a lecturer for a
  // sample of answers. Ground truth for the transcription error rate
  // (WER and CER) of the text the AI scored, see wer.js.
  referenceText String?

  // Populated only when the question has a steps rubric: an array of
  // { description, marks, awarded, reasoning } mirroring Question.steps,
  // for transparency during review.
  stepBreakdown Json?
}

// One page view or click, for the Analytics tab on the Admin page. No
// names or emails: visitorId is a random id kept in the browser, and paths
// have their ids replaced (/sessions/:id/results).
// type: PAGE_VIEW | CLICK
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String
  label     String?
  visitorId String
  userId    String?
  device    String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Institution > Faculty > Department. The list is kept in
// src/lib/institutions.js and copied in at start up. nextNumber hands out
// lecturer IDs one by one (NAU0001, NAU0002, ...).
model Institution {
  id         String    @id
  name       String
  code       String    @unique
  nextNumber Int       @default(1)
  faculties  Faculty[]
  users      User[]
}

model Faculty {
  id            String       @id @default(cuid())
  name          String
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  departments   Department[]

  @@unique([institutionId, name])
}

model Department {
  id        String  @id @default(cuid())
  name      String
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])
  users     User[]

  @@unique([facultyId, name])
}
